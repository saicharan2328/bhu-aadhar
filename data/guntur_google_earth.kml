        <Data name="owner"><value>Brodipet Commercial Association</value></Data>
      </ExtendedData>
      <Polygon>
        <extrude>1</extrude>
        <altitudeMode>relativeToGround</altitudeMode>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              80.4360,16.3060,0.0
              80.4370,16.3060,0.0
              80.4370,16.3070,0.0
              80.4360,16.3070,0.0
              80.4360,16.3060,0.0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>

